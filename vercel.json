{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://packing-list-1081640935031.us-west1.run.app/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://packing-list-1081640935031.us-west1.run.app/uploads/$1"
    },
    {
      "source": "/((?!api/|uploads/).*)",
      "destination": "/index.html"
    }
  ]
}
